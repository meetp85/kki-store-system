# Copy this file to ".env" and fill in your real Aiven MySQL details.
# NEVER commit the real ".env" file to GitHub - it's already in .gitignore.

MYSQL_HOST=your-service-xxxx.aivencloud.com
MYSQL_PORT=12345
MYSQL_USER=avnadmin
MYSQL_PASSWORD=your-aiven-password
MYSQL_DATABASE=defaultdb

# Any long random string - used to secure login sessions
SECRET_KEY=change-this-to-a-random-string

FLASK_ENV=development
